{
  "name": "backend",
  "version": "1.0.0",
  "description": "Basic Express + TypeScript application",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "concurrently \"tsc --watch\" \"nodemon dist/server.js\"",
